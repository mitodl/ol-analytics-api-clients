{
  "name": "@mitodl/ol-analytics-dashboard-api-axios",
  "version": "2026.10.27",
  "description": "Client for the B2B dashboard API of ol-analytics-api",
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/esm/index.d.ts",
  "scripts": {
    "build": "rm -rf dist && yarn build:esm && yarn build:cjs",
    "build:esm": "tsc",
    "build:cjs": "tsc --module commonjs --outDir dist/cjs",
    "prepack": "npm run build"
  },
  "author": "MIT Open Learning Engineering <oldevops@mit.edu>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mitodl/ol-analytics-api-clients.git",
    "directory": "src/typescript/ol-analytics-dashboard-api-axios"
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "license": "BSD-3",
  "devDependencies": {
    "typescript": "5.9.3"
  },
  "dependencies": {
    "axios": "^1.6.5"
  },
  "packageManager": "yarn@4.13.0"
}
